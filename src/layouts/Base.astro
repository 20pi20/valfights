---
import '@fontsource/anton/400.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/500.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../styles/global.css';
import { SITE } from '../config';
import { fights, formatDate, generatedAt, source } from '../lib/data';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Fights', active: path === '/' || path.startsWith('/fights') },
  { href: '/timeline/', label: 'Timeline', active: path.startsWith('/timeline') },
  { href: '/fighters/', label: 'Fighters', active: path.startsWith('/fighters') },
  { href: '/stats/', label: 'Stats', active: path.startsWith('/stats') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3ead7" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    {
      source === 'sample' && (
        <p class="sample-bar">Showing sample data — add your Notion credentials to .env to load your database.</p>
      )
    }
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">★</span>
          {SITE.title}
        </a>
        <nav aria-label="Main">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.active ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <span>{fights.length} bouts on the card</span>
        <span>Updated {formatDate(generatedAt)}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .sample-bar {
    margin: 0;
    padding: 0.5em var(--gutter);
    background: var(--gold);
    color: var(--on-gold);
    font-family: var(--label);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .masthead {
    border-bottom: 3px solid var(--text);
    background: rgba(243, 234, 215, 0.9);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .masthead-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 58px;
  }

  .brand {
    font-family: var(--display);
    font-size: 1.5rem;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 0.02em;
    display: flex;
    align-items: center;
    gap: 0.4em;
    white-space: nowrap;
  }

  .brand-mark {
    color: var(--red);
    font-size: 0.8em;
  }

  nav {
    display: flex;
    gap: clamp(0.9rem, 3vw, 2rem);
    overflow-x: auto;
  }

  @media (max-width: 520px) {
    .brand {
      font-size: 1.2rem;
    }

    nav {
      gap: 0.8rem;
    }

    nav a {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }
  }

  nav a {
    font-family: var(--label);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    padding-block: 1.05em;
    border-bottom: 3px solid transparent;
    margin-bottom: -3px;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--red);
  }

  main {
    flex: 1;
    padding-bottom: clamp(48px, 8vw, 96px);
  }

  .footer {
    border-top: 1px solid var(--line);
    font-family: var(--label);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.4rem;
  }
</style>
