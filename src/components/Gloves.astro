---
interface Props {
  rating: number | null;
}

const { rating } = Astro.props;
---

{
  rating == null ? (
    <span class="gloves gloves--none">Unrated</span>
  ) : (
    <span class="gloves" role="img" aria-label={`${rating} of 3 gloves`}>
      {[1, 2, 3].map((n) => (
        <span class:list={{ off: n > rating }} aria-hidden="true">
          🥊
        </span>
      ))}
    </span>
  )
}

<style>
  .gloves {
    display: inline-flex;
    gap: 0.12em;
    line-height: 1;
    white-space: nowrap;
  }

  .off {
    filter: grayscale(1);
    opacity: 0.28;
  }

  .gloves--none {
    font-family: var(--label);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
