---
// Horizontal bars for ranked categories. Items are drawn in the order given.
interface Item {
  label: string;
  value: number;
  href?: string;
}

interface Props {
  items: Item[];
  unit?: [string, string];
  empty?: string;
}

const { items, unit = ['bout', 'bouts'], empty = 'No data yet.' } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.value));
const total = items.reduce((sum, i) => sum + i.value, 0);
---

{
  items.length === 0 ? (
    <p class="none">{empty}</p>
  ) : (
    <ul class="bars">
      {items.map((item) => (
        <li title={`${item.label}: ${item.value} ${item.value === 1 ? unit[0] : unit[1]}${total ? ` (${Math.round((item.value / total) * 100)}%)` : ''}`}>
          <span class="name">{item.href ? <a href={item.href}>{item.label}</a> : item.label}</span>
          <span class="track">
            {item.value > 0 && <span class="bar" style={`width:${(item.value / max) * 100}%`} />}
          </span>
          <span class="value">{item.value}</span>
        </li>
      ))}
    </ul>
  )
}

<style>
  .bars {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) 2.5ch;
    align-items: center;
    gap: 0.9rem;
    padding: 0.42rem 0.5rem;
    margin-inline: -0.5rem;
  }

  li:hover {
    background: var(--surface-2);
  }

  .name {
    font-weight: 500;
    font-size: 0.98rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .name a {
    text-decoration: none;
  }

  .name a:hover {
    text-decoration: underline;
  }

  .track {
    display: block;
    height: 10px;
  }

  .bar {
    display: block;
    height: 100%;
    min-width: 3px;
    background: var(--red);
    border-radius: 0 4px 4px 0;
  }

  li:hover .bar {
    background: var(--red-deep);
  }

  .value {
    font-family: var(--label);
    font-weight: 700;
    font-size: 1.05rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .none {
    color: var(--muted);
    margin: 0;
  }

  @media (max-width: 480px) {
    li {
      grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr) 2.5ch;
      gap: 0.6rem;
    }
  }
</style>
