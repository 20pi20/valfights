---
// Vertical bars for ordered categories (decades, rounds, months).
interface Item {
  label: string;
  value: number;
  title?: string;
}

interface Props {
  items: Item[];
  unit?: [string, string];
  empty?: string;
}

const { items, unit = ['bout', 'bouts'], empty = 'No data yet.' } = Astro.props;
const max = Math.max(1, ...items.map((i) => i.value));
---

{
  items.length === 0 ? (
    <p class="none">{empty}</p>
  ) : (
    <div class="scroll">
      <ol class="cols" style={`--n:${items.length}`}>
        {items.map((item) => (
          <li title={`${item.title ?? item.label}: ${item.value} ${item.value === 1 ? unit[0] : unit[1]}`}>
            <span class="plot">
              <span class="value">{item.value > 0 ? item.value : ''}</span>
              <span class="bar" style={`height:${(item.value / max) * 100}%`} />
            </span>
            <span class="tick">{item.label}</span>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .scroll {
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .cols {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(30px, 1fr));
    gap: 2px;
    min-width: calc(var(--n) * 32px);
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
  }

  .plot {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    width: 100%;
    height: 170px;
    border-bottom: 1px solid var(--line);
  }

  .bar {
    width: min(60%, 34px);
    background: var(--red);
    border-radius: 4px 4px 0 0;
  }

  li:hover .bar {
    background: var(--red-deep);
  }

  li:hover .plot {
    background: var(--surface-2);
  }

  .value {
    font-family: var(--label);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .tick {
    margin-top: 0.4rem;
    font-family: var(--label);
    font-weight: 600;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .none {
    color: var(--muted);
    margin: 0;
  }
</style>
